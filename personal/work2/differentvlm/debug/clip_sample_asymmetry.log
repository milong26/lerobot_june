  set_alpha_to_one:  True
  steps_offset:      0

  num_inference_timesteps: 10

[Critical Analysis]
  clip_sample=True means:
    During each DDIM step, scheduler.step() clips the predicted x_0 to [-clip_sample_value, clip_sample_value]
    Default clip_sample_value = 1.0
    This assumes the clean sample x_0 is in [-1, 1]
    But with MEAN_STD normalization, x_0 can be outside [-1, 1]
    => CLIPPING WILL OCCUR AND SHRINK THE ACTION DISTRIBUTION

